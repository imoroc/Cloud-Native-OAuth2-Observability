      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Tráfico del Servidor (RPS)",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "efieig3h3m328a"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "# Muestra el volumen de tráfico (RPS: Peticiones Por Segundo).\r\n# 1. irate(...) calcula la velocidad de peticiones en el último minuto. Usamos 'irate' en vez de 'rate' porque es mucho mejor para detectar picos súper rápidos y agresivos.\r\n# 2. sum(...) by (status_code) agrupa esas peticiones por su código de respuesta (200, 401, 500...), permitiendo pintar líneas de distintos colores.\r\nsum(irate(http_requests_total[1m])) by (status_code)",
                        "instant": false,
                        "legendFormat": "__auto",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
