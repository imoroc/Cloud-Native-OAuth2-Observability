      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Latencia P95",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "efieig3h3m328a"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[1m])) by (le))\r\n# Calcula qué lentitud máxima está experimentando el 95% de los usuarios.\r\n# 1. rate(...) calcula cuántas peticiones por segundo entran en los cajones (buckets) en el último minuto.\r\n# 2. sum(...) by (le) junta todos los datos del servidor pero mantiene separados los cajones de tiempo.\r\n# 3. histogram_quantile(0.95, ...) coge esos cajones y hace el cálculo estadístico para sacar la línea del P95.",
                        "instant": false,
                        "legendFormat": "__auto",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
